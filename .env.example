# Скопируйте этот файл в `.env` (cp .env.example .env) и поправьте значения.
# `docker compose` сам читает `.env` из корня репозитория. Для запуска без Docker
# используйте scripts/start-server.ps1 (Windows) или scripts/start-server.sh:
# обычный `python service/scripts/server.py` файл `.env` НЕ читает.
#
# Всё необязательно: без настроек сервис работает, но очистка текста (слой B,
# перефразирование и замена слов) требует настроенного бэкенда, см. блок ниже.
# Комментарии пишите отдельными строками, не в конце строки со значением.

# ---------------------------------------------------------------------------
# HTTP-сервис (wr-core)
# ---------------------------------------------------------------------------
# Необязательный токен. Если задан, каждый запрос должен содержать
# заголовок `Authorization: Bearer <ключ>`.
WATERMARKS_SERVER_API_KEY=

# Где искать сервис клиентам (скилл, curl). По умолчанию http://127.0.0.1:8765.
# WATERMARKS_SERVICE_URL=http://127.0.0.1:8765

# ---------------------------------------------------------------------------
# Слой B: перефразирование и замена слов локальной моделью (Ollama)
# ---------------------------------------------------------------------------
# Бэкенд: ollama или openai-compatible.
WATERMARKS_REWRITE_BACKEND=ollama
# Лучшая из проверенных моделей для русского (ollama pull ... скачивает её):
#   ollama pull yandex/YandexGPT-5-Lite-8B-instruct-GGUF
WATERMARKS_REWRITE_MODEL=yandex/YandexGPT-5-Lite-8B-instruct-GGUF:latest
WATERMARKS_REWRITE_BASE_URL=http://127.0.0.1:11434
# Сколько держать модель в видеопамяти после последнего ответа (30s, 2m или секунды; 0 = выгружать сразу).
# Пока Claude присылает части подряд, модель не успевает выгрузиться и не загружается заново для каждой части;
# когда работа закончена, память освобождается сама через это время. По умолчанию Ollama держит её 5 минут.
WATERMARKS_REWRITE_KEEP_ALIVE=30s
# Окно контекста Ollama в токенах. Замена слов использует короткие запросы
# (около 250 токенов), а перефразирование всего текста должно вместить текст
# и ответ: для текстов длиннее ~1500 токенов увеличьте значение.
WATERMARKS_REWRITE_NUM_CTX=4096
# Ключ для облачных openai-compatible API (только через окружение).
# WATERMARKS_REWRITE_API_KEY=
# Разрешить не-локальный адрес бэкенда.
# WATERMARKS_REWRITE_ALLOW_REMOTE=1
# WATERMARKS_REWRITE_REASONING_EFFORT=none
# Число вариантов на раунд проверки и число раундов (по умолчанию 1 и 1).
# WATERMARKS_REWRITE_CANDIDATES=1
# WATERMARKS_REWRITE_LOOPS=1

# ---------------------------------------------------------------------------
# Замена слов синонимами (тактика swap)
# ---------------------------------------------------------------------------
# Сколько слов вокруг заменяемого показывать модели с каждой стороны.
WATERMARKS_SWAP_WINDOW=10
# Бюджет запроса в токенах: если окно не помещается, оно сужается, а в консоль
# и в `report.warnings` попадает предупреждение.
WATERMARKS_SWAP_CTX_TOKENS=1200
# Язык подсказки: auto | ru | ru_short | en. auto выбирает по тексту.
WATERMARKS_SWAP_PROMPT=auto
# Проверка слов по словарю и формы через pymorphy3 (pip install -r requirements.txt).
# 0 отключает проверку.
WATERMARKS_SWAP_MORPH=1
# Файл с дополнительными допустимыми словами (по одному в строке): термины,
# которых нет в словаре.
# WATERMARKS_SWAP_WORDLIST=
# Проверка смысла каждой замены вторым запросом (только Ollama). Поднимает долю
# удачных замен примерно с 58% до 74%, но замедляет примерно в 2,5 раза.
WATERMARKS_SWAP_VERIFY=1
# Порог проверки: чем выше, тем строже (меньше замен, но точнее). Оставьте закомментированным:
# тогда порог берётся из config/model_profiles.json под модель (у каждой модели своя шкала оценок).
# WATERMARKS_SWAP_VERIFY_MIN=12
# Другая модель в роли проверяющего (по умолчанию та же, что для замены).
# WATERMARKS_SWAP_VERIFY_MODEL=
# Ограничения на один запрос: максимум токенов ответа и таймаут в секундах.
WATERMARKS_SWAP_MAX_TOKENS=24
WATERMARKS_SWAP_CALL_TIMEOUT=120

# ---------------------------------------------------------------------------
# Оценка времени (POST /estimate)
# ---------------------------------------------------------------------------
# Файл, где сервис запоминает скорость прошлых прогонов, чтобы оценки подходили
# именно вашему компьютеру. По умолчанию лежит во временной папке системы.
# WATERMARKS_STATE_FILE=
# Список моделей с относительной скоростью и качеством, из которого берутся
# предложения «взять модель быстрее» (по умолчанию config/model_profiles.json).
# WATERMARKS_MODEL_PROFILES_FILE=

# ---------------------------------------------------------------------------
# Необязательные тяжёлые компоненты (профили harness / heavy)
# ---------------------------------------------------------------------------
# Токен Hugging Face для закрытых моделей (CtrlRegen, MarkLLM, MarkDiffusion).
HF_TOKEN=
# Модель для тактики mlm (нужны torch и transformers; в стратегии по умолчанию не используется).
# roberta-large работает только с английским.
# WATERMARKS_MLM_MODEL=xlm-roberta-base

# Исследовательский стенд MarkLLM (только локальный каталог, не входит в образ).
# WATERMARKS_MARKLLM_DIR=~/MarkLLM
# WATERMARKS_MARKLLM_SCHEME=kgw

# Оценка SynthID для изображений по HTTP (профиль heavy).
# WATERMARKS_SYNTHID_SCORER_URL=http://wr-synthid-score:8766
# WATERMARKS_SYNTHID_SCORER_API_KEY=
# WATERMARKS_SYNTHID_SCORER_TIMEOUT=60
