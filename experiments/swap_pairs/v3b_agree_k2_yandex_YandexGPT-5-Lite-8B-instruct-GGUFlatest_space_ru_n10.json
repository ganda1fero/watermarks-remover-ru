[["практической", "прикладной", "они легли в основу всей", "космонавтики двадцатого века.\n\nЧетвёртого"], ["радиосигналы", "радиопередачи", "минут, а его простые", "слушали любители по всему миру"], ["первый полёт", "первое путешествие", "1961 года Юрий Гагарин совершил", "человека в космос. Весь"], ["рукотворным", "искусственным", "эту границу и стал первым", "объектом в межзвёздном пространстве."], ["дольше", "больше", "«Спирит» и «Оппортьюнити» проработали намного", "запланированного срока, а аппарат"], ["миров", "планет", "с тех пор число подтверждённых", "перевалило за пять тысяч."], ["звезды", "светила", "жидкой. Однако до ближайшей", ", Проксимы Центавра, около"], ["быстрому", "скоростному", "года, и даже самому", "из современных аппаратов потребовались бы"], ["груза", "массы", "что снизило стоимость выведения килограмма", "на орбиту в несколько раз"], ["двигателями", "моторами", "Инженеры работают над ядерными", ", солнечными парусами и системами"], ["успех", "достижение", "Тем не менее каждый новый", "подтверждает мысль Циолковского о том"], ["рано", "вскоре", "о том, что человечество", "или поздно выйдет за пределы"]]